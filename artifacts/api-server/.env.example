# ── api-server local development environment ──────────────────────────────────
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to source control.

# ── Required (server will exit immediately without these) ─────────────────────
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/unsdb
JWT_SECRET=change-me-to-a-long-random-string

# ── Required in production/staging only (warn-only in dev) ───────────────────
ADMIN_SECRET=change-me-admin-secret
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@example.com
SMTP_PASS=smtp-password

# ── Optional (features degrade gracefully when absent) ───────────────────────
# Companion LLM. Provide EITHER of the following. If both are set, Groq wins.
# If neither is set, the companion falls back to a rule-based reply (no crash).
# Groq API key — get one free at console.groq.com
# Model used: llama-3.3-70b-versatile (can override via PUT /admin/ai-config)
GROQ_API_KEY=gsk_...
# OpenAI API key — used when GROQ_API_KEY is absent (model: gpt-4o by default)
OPENAI_API_KEY=sk-...

# ── Feature flags ────────────────────────────────────────────────────────────
# "true" turns on email OTP verification; anything else keeps the MVP bypass.
VERIFICATION_ENABLED=false

# ── CORS — leave empty in local dev (all origins allowed automatically) ───────
# In production, set to a comma-separated list of allowed frontend origins:
# ALLOWED_ORIGINS=https://your-app.com,https://admin.your-app.com
ALLOWED_ORIGINS=

NODE_ENV=development
