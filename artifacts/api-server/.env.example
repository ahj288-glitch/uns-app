# ── api-server local development environment ──────────────────────────────────
# Copy this file to .env and fill in real values before running the server.
# Never commit .env to source control.

# ── Required (server will exit immediately without these) ─────────────────────
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/unsdb
JWT_SECRET=change-me-to-a-long-random-string

# ── Required in production/staging only (warn-only in dev) ───────────────────
ADMIN_SECRET=change-me-admin-secret
SMTP_HOST=smtp.example.com
SMTP_USER=noreply@example.com
SMTP_PASS=smtp-password

# ── Optional (features degrade gracefully when absent) ───────────────────────
OPENAI_API_KEY=sk-...

# ── CORS — leave empty in local dev (all origins allowed automatically) ───────
# In production, set to a comma-separated list of allowed frontend origins:
# ALLOWED_ORIGINS=https://your-app.com,https://admin.your-app.com
ALLOWED_ORIGINS=

NODE_ENV=development
