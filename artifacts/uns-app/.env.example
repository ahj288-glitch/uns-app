# ── uns-app (Expo) environment ────────────────────────────────────────────────
# Copy to .env and adjust. Only EXPO_PUBLIC_* vars are exposed to the client bundle.

# Base URL of the api-server. Full URL wins over EXPO_PUBLIC_DOMAIN.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Feature flag: "true" enables the email OTP verification screen; anything else
# keeps MVP mode (register/login return tokens directly, no OTP screen).
EXPO_PUBLIC_VERIFICATION_ENABLED=false
